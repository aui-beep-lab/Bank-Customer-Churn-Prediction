```{r}
### Model Performance Visualization
# Define function to extract metrics from confusionMatrix objects
extract_metrics <- function(cm) {
  c(
    Accuracy = cm$overall["Accuracy"],
    Kappa = cm$overall["Kappa"],
    Sensitivity = cm$byClass["Sensitivity"],
    Specificity = cm$byClass["Specificity"],
    Balanced_Accuracy = cm$byClass["Balanced Accuracy"]
  )
}

# Extract metrics for each model
metrics_rf <- extract_metrics(cm_rf)
metrics_xgb <- extract_metrics(cm_xgb)
metrics_tree <- extract_metrics(cm_tree)
metrics_log <- extract_metrics(cm_log)
metrics_knn <- extract_metrics(cm_knn)

# Create a list of metrics for each model
metrics_list <- list(
  "Random Forest" = metrics_rf,
  "XGBoost" = metrics_xgb,
  "Decision Tree" = metrics_tree,
  "Logistic Regression" = metrics_log,
  "KNN" = metrics_knn
)

# Convert the list into a data frame for plotting
metrics_df <- bind_rows(
  lapply(names(metrics_list), function(model) {
    data.frame(
      Model = model,
      Metric = names(metrics_list[[model]]),
      Value = metrics_list[[model]]
    )
  })
)

# Create the bar plot
ggplot(metrics_df, aes(x = Model, y = Value, fill = Metric)) +
  geom_bar(stat = "identity", position = "dodge") +
  scale_y_continuous(limits = c(0, 1)) +
  labs(title = "Model Performance Comparison", x = "Model", y = "Score") +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
  scale_fill_brewer(palette = "Set1")
```
