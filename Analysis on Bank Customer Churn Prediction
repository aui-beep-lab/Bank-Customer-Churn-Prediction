### 3. Data Preparation
```{r data-prep}
# Convert and clean columns
data <- raw_data %>%
  mutate(
    balance = as.numeric(gsub(",", "", balance)),
    estimated_salary = as.numeric(gsub(",", "", estimated_salary)),
    Gender = as.factor(gender),
    Geography = as.factor(country),
    HasCrCard = as.factor(credit_card),
    IsActiveMember = as.factor(active_member),
    Age = as.numeric(age),
    Tenure = as.numeric(tenure),
    NumOfProducts = as.numeric(products_number),
    churn = factor(churn, levels = c(0, 1), labels = c("No", "Yes"))
  ) %>%
  select(-customer_id, -gender, -country, -credit_card, -active_member, -age, -tenure, -products_number)

# Handle missing values
missing_summary <- sapply(data, function(x) sum(is.na(x)))
print("Missing values per column:")
print(missing_summary)

for (col in names(data)) {
  if (any(is.na(data[[col]]))) {
    if (is.numeric(data[[col]])) {
      median_val <- median(data[[col]], na.rm = TRUE)
      data[[col]][is.na(data[[col]])] <- median_val
    } else if (is.factor(data[[col]])) {
      mode_val <- names(which.max(table(data[[col]])))
      data[[col]][is.na(data[[col]])] <- mode_val
    }
  }
}

stopifnot(sum(is.na(data)) == 0)

# Split data
set.seed(123)
train_index <- createDataPartition(data$churn, p = 0.7, list = FALSE)
train_data <- data[train_index, ]
test_data <- data[-train_index, ]
```

### 4. Modeling
```{r modeling}
# Set up 5-fold cross-validation control
ctrl <- trainControl(method = "cv", number = 5)

# Random Forest with cross-validation
model_rf <- train(churn ~ ., data = train_data, method = "rf", trControl = ctrl, tuneLength = 3)
pred_rf <- predict(model_rf, test_data)

# XGBoost with manual 5-fold cross-validation
set.seed(123)
folds <- createFolds(train_data$churn, k = 5, list = TRUE, returnTrain = FALSE)
xgb_cv_results <- list()
for (i in 1:5) {
  test_fold <- folds[[i]]
  train_fold <- unlist(folds[-i])
  train_fold_data <- train_data[train_fold, ]
  test_fold_data <- train_data[test_fold, ]
  full_matrix <- model.matrix(churn ~ . - 1, data = train_fold_data)
  y_train <- as.numeric(train_fold_data$churn) - 1
  model_xgb <- xgboost(data = full_matrix, label = y_train, nrounds = 50, objective = "binary:logistic", verbose = 0)
  pred_prob <- predict(model_xgb, model.matrix(churn ~ . - 1, data = test_fold_data))
  pred_xgb_fold <- ifelse(pred_prob > 0.5, "Yes", "No") %>% factor(levels = c("No", "Yes"))
  xgb_cv_results[[i]] <- confusionMatrix(pred_xgb_fold, test_fold_data$churn)$overall["Accuracy"]
}
mean_xgb_acc <- mean(unlist(xgb_cv_results))
pred_xgb <- predict(xgboost(data = model.matrix(churn ~ . - 1, data = train_data), 
                            label = as.numeric(train_data$churn) - 1, 
                            nrounds = 50, objective = "binary:logistic", verbose = 0), 
                    model.matrix(churn ~ . - 1, data = test_data))
pred_xgb <- ifelse(pred_xgb > 0.5, "Yes", "No") %>% factor(levels = c("No", "Yes"))

# Decision Tree with cross-validation
model_tree <- train(churn ~ ., data = train_data, method = "rpart", trControl = ctrl, tuneLength = 3)
pred_tree <- predict(model_tree, test_data)

# Logistic Regression with cross-validation
model_log <- train(churn ~ ., data = train_data, method = "glm", family = "binomial", trControl = ctrl)
pred_prob_log <- predict(model_log, test_data, type = "prob")  # Fix: Use type = "prob" to get probabilities
pred_log <- ifelse(pred_prob_log[, "Yes"] > 0.5, "Yes", "No") %>% factor(levels = c("No", "Yes"))

# K-Nearest Neighbors with cross-validation
train_data$churn <- factor(train_data$churn, levels = c("No", "Yes"))
test_data$churn <- factor(test_data$churn, levels = c("No", "Yes"))
dummies <- dummyVars(~ ., data = train_data %>% select(-churn))
train_knn <- predict(dummies, newdata = train_data) %>% as.data.frame()
test_knn <- predict(dummies, newdata = test_data) %>% as.data.frame()
model_knn <- train(x = train_knn, y = train_data$churn, method = "knn", trControl = ctrl, tuneLength = 3)
pred_knn <- predict(model_knn, test_knn)
```

